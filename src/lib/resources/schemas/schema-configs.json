{
    "extended_wheel": {
        "config": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
                "config": {
                    "type": "object",
                    "properties": {
                "wheels": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "display": { 
                                "type": "string"
                            },
                            "note": {
                                "type": "string"
                            },
                            "settings": {
                                "type": "object",
                                "properties": {
                                    "disabled": {
                                        "type": "boolean"
                                    },
                                    "hiddenEffects": {
                                        "type": "boolean"
                                    },
                                    "hiddenOutcomes": {
                                        "type": "boolean"
                                    },
                                    "hiddenWeights": {
                                        "type": "boolean"
                                    }
                                },
                                "required": ["disabled", "hiddenEffects", "hiddenOutcomes", "hiddenWeights"]
                            },
                            "regularity": {
                                "type": "object",
                                "properties": {
                                    "interval": {
                                        "type": "integer",
                                        "minimum": 60000
                                    },
                                    "mode": {
                                        "type": "string",
                                        "enum": ["cumulative", "non_cumulative", "unlimited"]
                                    },
                                    "spinsPerPeriod": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "maximum": {
                                        "type": "integer",
                                        "minimum": 1
                                    }
                                },
                                "required": ["interval", "mode"]
                            },
                            "outcomes": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "weight": {
                                            "type": "string",
                                            "pattern": "^\\d+(\\.\\d+)?$"
                                        },
                                        "text": {
                                            "type": "string"
                                        },
                                        "effects": {
                                            "$ref": "/lockEffects"
                                        }
                                    },
                                    "required": ["weight", "text", "effects"]
                                }
                            }
                        },
                        "required": ["display", "settings", "regularity", "outcomes"]
                    }
                }
                    },
                    "required": ["wheels"]
                }
            },
            "required": ["config"]
        },
        "custom": {
            "type": "object",
            "properties": {
                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "lastSpinMS": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "availableSpins": { "type": "integer", "minimum": 0 },
                            "bonusSpins": { "type": "integer", "minimum": 0 },
                            "periodStartedAtMS": { "type": ["integer", "null"], "minimum": 0 },
                            "lastTrackMS": { "type": "integer", "minimum": 0 },
                            "count": {
                                "type": "object",
                                "additionalProperties": { "type": "integer", "minimum": 0 }
                            }
                        },
                        "required": ["lastSpinMS"]
                    }
                }
            },
            "required": ["custom"]
        }
    },
    "strawberria_penalties": {
        "config": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
                "extended_wheel": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "/penaltyData"
                    }
                }
            },
            "required": []
        },
        "custom": {}
    },
    "jigsaw_puzzles": {
        "config": {},
        "custom": {}
    },
    "typing_tasks": {
        "config": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
                "tasks": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "display": { 
                                "type": "string"
                            },
                            "note": {
                                "type": "string"
                            },
                            "feedback": {
                                "type": "string"
                            },
                            "settings": {
                                "type": "object",
                                "properties": {
                                    "times": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    },
                                    "extra": {
                                        "type": "number",
                                        "minimum": 0
                                    },
                                    "delayMS": {
                                        "type": "number",
                                        "minimum": 0
                                    },
                                    "delayExtra": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    },
                                    "hidden": {
                                        "type": "boolean"
                                    },
                                    "chinese": {
                                        "type": "boolean"
                                    }
                                },
                                "required": ["times", "extra", "delayMS", "delayExtra", "hidden", "chinese"]
                            },
                            "phrases": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": ["display", "settings", "phrases"]
                    }
                }
            },
            "required": ["tasks"]
        },
        "custom": {}
    }
}
